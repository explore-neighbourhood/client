# Next.js forwards API calls to this Node server.
API_ORIGIN=http://127.0.0.1:4000
# Browser Maps and Street View. Public browser key, restricted by HTTP referrer.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=AIzaSyD7rqUpTzUpEbxm-Xc7ikltFJGzOhd92Qk
# Local preview map ID. Replace with your owned JavaScript map ID for deployment.
NEXT_PUBLIC_GOOGLE_MAP_ID=DEMO_MAP_ID
# Approved HTTPS origins allowed to embed this app. Empty uses standalone mode.
EMBED_FRAME_ANCESTORS=http://localhost:3302

# Labeled Bellandur visualization entry
NEXT_PUBLIC_DEMO_MODE=true
