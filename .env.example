# Next.js API proxy destination. Use the EC2 HTTPS API origin on Vercel.
API_ORIGIN=http://127.0.0.1:4000

# Public browser key for Maps JavaScript and browser Street View.
# Enable the Elevation API for the terrain-following Google 3D person camera.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# DEMO_MAP_ID works for local preview. Use your owned JavaScript map ID on Vercel.
NEXT_PUBLIC_GOOGLE_MAP_ID=DEMO_MAP_ID

# Space-separated approved HTTPS frame origins. Local development accepts loopback HTTP. Empty disables embedding.
EMBED_FRAME_ANCESTORS=

# Show the optional Bellandur visualization entry when demo inventory is seeded.
NEXT_PUBLIC_DEMO_MODE=false
